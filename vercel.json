{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://dance-and-friends-omsk.ru/",
      "permanent": true
    },
    {
      "source": "/:path((?!assets/).+)",
      "destination": "https://dance-and-friends-omsk.ru/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
